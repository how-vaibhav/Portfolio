# ──────────────────────────────────────────────
#  Portfolio — .gitignore
#  Node.js + React (Vite) monorepo
# ──────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build output ──────────────────────────────
dist/
build/
out/
.output/

# ── Vite cache & temp ─────────────────────────
.vite/
.vite-temp/
frontend/.vite/

# ── Environment variables ─────────────────────
# Keep .env.example — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS & editor junk ──────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDE / editor configs ──────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Testing & coverage ────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Misc ──────────────────────────────────────
*.local
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
